# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional Custom Fastify Backend URL (if deployed on Render / Railway / Koyeb)
NEXT_PUBLIC_BACKEND_URL=

# Simple Invoicing Service (Render + Vercel)
INVOICING_BACKEND_URL=https://<your-service-name>.onrender.com
INVOICING_FRONTEND_URL=https://<your-invoicing-frontend>.vercel.app

# App Environment
NEXT_PUBLIC_APP_ENV=production
